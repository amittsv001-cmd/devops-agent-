# Copy to .env and fill in. NEVER commit the real .env file.

# --- LLM ---
LLM_PROVIDER=anthropic
LLM_MODEL=claude-3-5-sonnet-latest
ANTHROPIC_API_KEY=
LLM_MAX_TOKENS=8192
# Optional price override, USD per 1M tokens:
# MODEL_PRICING_JSON={"claude-3-5-sonnet": {"input": 3.0, "output": 15.0}}

# --- Workspace / safety ---
WORKSPACE_ROOT=.
DRY_RUN=true
MAX_FILE_CHARS=20000
# Comma-separated Slack user IDs allowed to use the bot (empty = everyone)
ALLOWED_SLACK_USER_IDS=
MCP_ALLOWED_COMMANDS=git,pytest,npm,ls
LOG_LEVEL=INFO

# --- Slack ---
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=

# --- GitHub ---
GITHUB_TOKEN=
GITHUB_REPO=owner/repo
# Empty = repository default branch
GITHUB_BASE_BRANCH=
